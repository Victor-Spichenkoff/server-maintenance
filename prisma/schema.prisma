generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Api {
  id                    Int     @id @default(autoincrement())
  currentMaintainedId   Int     @default(9999)
  currentMaintainedUrl  String  @default("https://google.com")
  currentMaintainedName String  @default("Nothing Selected")
  off                   Boolean
  highMessages          Boolean @default(false)
}

model Time {
  id                 Int     @id @default(autoincrement())
  currentMonth       Int
  keepThisApiOn      Boolean
  usageMainAccount   BigInt
  usageThisAccount   BigInt
  lastStart          BigInt?
  lastDiscount       BigInt?
  alreadyStartedThis Boolean
}

model Server {
  id                     Int     @id @default(autoincrement())
  label                  String
  shortLabel             String?
  fullUrl                String  @unique
  isActive               Boolean @default(false)
  LastCalled             DateTime?
  LastCalledSuccessfully DateTime?
  callOnAll              Boolean @default(false)
}
